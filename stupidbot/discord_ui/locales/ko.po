msgctxt "deletion"
msgid "-# Deletes {relative_time}"
msgstr "-# {relative_time} 삭제됩니다"

msgctxt "access_title"
msgid "Access denied"
msgstr "접근 거부"

msgctxt "discord_error"
msgid "Could not complete the action in Discord. Please try again."
msgstr "Discord에서 작업을 완료하지 못했습니다. 다시 시도해 주세요."

msgctxt "internal_error"
msgid "Could not complete the command. Details were logged."
msgstr "명령어를 실행하지 못했습니다. 오류 정보가 기록되었습니다."

msgctxt "discord_title"
msgid "Discord error"
msgstr "Discord 오류"

msgctxt "internal_title"
msgid "Internal error"
msgstr "내부 오류"

msgctxt "cooldown"
msgid "Please wait: {relative_time}"
msgstr "잠시 기다려 주세요: {relative_time}"

msgctxt "report"
msgid "Report a problem"
msgstr "문제 신고"

msgctxt "access"
msgid "The command access check failed."
msgstr "명령어 사용 권한을 확인하지 못했습니다."

msgctxt "guild_only"
msgid "This command can only be used in a server"
msgstr "이 명령어는 서버에서만 사용할 수 있습니다"

msgctxt "not_yours"
msgid "This is not your message."
msgstr "다른 사용자의 메시지입니다."

msgctxt "page"
msgid "{name} (page {page:d})"
msgstr "{name} ({page:d}페이지)"

msgctxt "blocked"
msgid "You cannot use commands."
msgstr "명령어를 사용할 수 없습니다."
