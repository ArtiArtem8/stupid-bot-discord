msgctxt "ui"
msgid "API Error"
msgstr "API 오류"

msgctxt "ui"
msgid "API Rate Limit Error"
msgstr "API 요청 한도 초과"

msgctxt "ui"
msgid "API-Key Error"
msgstr "API 키 오류"

msgctxt "ui"
msgid "Cannot upload images in this context."
msgstr "여기에서는 이미지를 업로드할 수 없습니다."

msgctxt "command"
msgid "Equation to solve (e.g. x^2 + 2x + 1 = 0)"
msgstr "풀 방정식 (예: x^2 + 2x + 1 = 0)"

msgctxt "ui"
msgid "Expression:"
msgstr "수식:"

msgctxt "ui"
msgid "Failed to process graph image."
msgstr "그래프 이미지를 처리하지 못했습니다."

msgctxt "command"
msgid "Function to plot (e.g. sin(x)/x)"
msgstr "그래프로 그릴 함수 (예: sin(x)/x)"

msgctxt "graph"
msgid "Graph generated: {url}"
msgstr "그래프를 생성했습니다: {url}"

msgctxt "ui"
msgid "Image Error"
msgstr "이미지 오류"

msgctxt "ui"
msgid "Internal Error"
msgstr "내부 오류"

msgctxt "invalid_response"
msgid "Invalid XML response"
msgstr "잘못된 XML 응답"

msgctxt "ui"
msgid "No Plot"
msgstr "그래프 없음"

msgctxt "ui"
msgid "No Results"
msgstr "결과 없음"

msgctxt "ui"
msgid "No displayable results found.\nAll results were filtered out."
msgstr "표시할 수 있는 결과가 없습니다.\n모든 결과가 필터링되었습니다."

msgctxt "ui"
msgid "No graph generated."
msgstr "그래프가 생성되지 않았습니다."

msgctxt "no_results"
msgid "No results found"
msgstr "결과를 찾을 수 없습니다"

msgctxt "command"
msgid "Plot a mathematical function"
msgstr "함수 그래프 그리기"

msgctxt "ui"
msgid "Query empty or too long."
msgstr "검색어가 비어 있거나 너무 깁니다."

msgctxt "query"
msgid "Query: `{query}`"
msgstr "검색어: `{query}`"

msgctxt "results"
msgid "Results: {url}"
msgstr "결과: {url}"

msgctxt "ui"
msgid "Session not initialized."
msgstr "세션이 초기화되지 않았습니다."

msgctxt "command"
msgid "Solve a mathematical equation"
msgstr "방정식 풀기"

msgctxt "command"
msgid "Solve with Wolfram"
msgstr "Wolfram으로 계산하기"

msgctxt "ui"
msgid "The API key is not set."
msgstr "API 키가 설정되지 않았습니다."

msgctxt "unknown_api_error"
msgid "Unknown API Error"
msgstr "알 수 없는 API 오류"

msgctxt "ui"
msgid "Wolfram could not understand the input."
msgstr "Wolfram이 입력 내용을 이해하지 못했습니다."

msgctxt "ui"
msgid "Wolfram request stopped during reload. Please try again."
msgstr "다시 불러오는 중에 Wolfram 요청이 중단되었습니다. 다시 시도해 주세요."

msgctxt "ui"
msgid "Wolfram|Alpha is temporarily rate-limited. Please try again later."
msgstr "Wolfram|Alpha의 요청 한도에 도달했습니다. 잠시 후 다시 시도해 주세요."

msgctxt "ui"
msgid "Wolfram|Alpha request failed. Please try again later."
msgstr "Wolfram|Alpha 요청에 실패했습니다. 잠시 후 다시 시도해 주세요."

msgctxt "plot"
msgid "{mention} [Wolfram]({url}) **Plot:** `{query}`"
msgstr "{mention} [Wolfram]({url}) **그래프:** `{query}`"
