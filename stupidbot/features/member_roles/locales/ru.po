#, python-brace-format
msgctxt "skipped"
msgid ""
"\n"
"\n"
"Skipped {count:d} role (deleted, inaccessible or the request failed). Existing roles"
" not yet granted have been kept for another attempt."
msgid_plural ""
"\n"
"\n"
"Skipped {count:d} roles (deleted, inaccessible or the request failed). Existing roles"
" not yet granted have been kept for another attempt."
msgstr[0] ""
"\n"
"\n"
"Пропущена {count:d} роль (удалена, недоступна или запрос завершился ошибкой). "
"Существующие невыданные роли сохранены для повторной попытки."
msgstr[1] ""
"\n"
"\n"
"Пропущено {count:d} роли (удалены, недоступны или запрос завершился ошибкой). "
"Существующие невыданные роли сохранены для повторной попытки."
msgstr[2] ""
"\n"
"\n"
"Пропущено {count:d} ролей (удалены, недоступны или запрос завершился ошибкой). "
"Существующие невыданные роли сохранены для повторной попытки."

#, python-brace-format
msgctxt "snapshot"
msgid "- **{name}** — {count:d} role, left {timestamp}"
msgid_plural "- **{name}** — {count:d} roles, left {timestamp}"
msgstr[0] "- **{name}** — {count:d} роль, вышел {timestamp}"
msgstr[1] "- **{name}** — {count:d} роли, вышел {timestamp}"
msgstr[2] "- **{name}** — {count:d} ролей, вышел {timestamp}"

msgctxt "command"
msgid "Days to retain snapshots. Leave empty for unlimited retention"
msgstr "Количество дней хранения снимков. Пусто = бесконечно"

msgctxt "command"
msgid "Delete a member's saved role snapshot"
msgstr "Удалить сохранённый снимок ролей участника"

msgctxt "command"
msgid "Disable server monitoring"
msgstr "Отключить мониторинг сервера"

msgctxt "ui"
msgid "Disabled"
msgstr "Отключён"

msgctxt "command"
msgid "Enable server monitoring and automatic role restoration"
msgstr "Включить мониторинг сервера и автовосстановление ролей"

msgctxt "ui"
msgid "Enabled"
msgstr "Включён"

msgctxt "ui"
msgid "Insufficient permissions"
msgstr "Недостаточно прав"

msgctxt "command"
msgid "Manage server monitoring and role restoration"
msgstr "Управление мониторингом сервера и восстановлением ролей"

msgctxt "command"
msgid "Manually restore a member's roles"
msgstr "Вручную восстановить роли участнику"

msgctxt "command"
msgid "Member whose roles should be restored"
msgstr "Участник, которому нужно восстановить роли"

msgctxt "command"
msgid "Member whose snapshot should be deleted"
msgstr "Участник, чей снимок нужно удалить"

msgctxt "ui"
msgid "Monitoring disabled"
msgstr "Мониторинг отключён"

msgctxt "ui"
msgid "Monitoring enabled"
msgstr "Мониторинг включён"

msgctxt "ui"
msgid "Monitoring is already disabled on this server."
msgstr "Мониторинг уже отключён на этом сервере."

#, python-brace-format
msgctxt "status"
msgid "Monitoring status: {guild}"
msgstr "Статус мониторинга: {guild}"

msgctxt "ui"
msgid ""
"No roles to restore: the snapshot is missing or expired, or the roles have already "
"been granted."
msgstr ""
"Нет ролей для восстановления: снимок отсутствует, его срок хранения истёк или роли "
"уже выданы."

#, python-brace-format
msgctxt "missing"
msgid "No saved roles found for {mention}."
msgstr "Для {mention} не найдено сохранённых ролей."

#, python-brace-format
msgctxt "recent"
msgid "Recent members ({shown:d} of {total:d})"
msgstr "Недавние участники ({shown:d} из {total:d})"

#, python-brace-format
msgctxt "restoration"
msgid "Role restoration: {name}"
msgstr "Восстановление ролей: {name}"

#, python-brace-format
msgctxt "deleted"
msgid "Role snapshot for {mention} deleted."
msgstr "Снимок ролей для {mention} удалён."

#, python-brace-format
msgctxt "restored"
msgid "Roles restored: {count:d}"
msgstr "Восстановлено ролей: {count:d}"

msgctxt "ui"
msgid "Saved role snapshots have been kept. Use `/monitor forget` to delete them."
msgstr "Сохранённые снимки ролей не удалены. Используйте `/monitor forget` для очистки."

msgctxt "command"
msgid "Show monitoring status and saved members"
msgstr "Показать статус мониторинга и список сохранённых участников"

#, python-brace-format
msgctxt "footer"
msgid "Showing the first 10 of {total:d} snapshots"
msgstr "Показаны первые 10 снимков из {total:d}"

msgctxt "ui"
msgid "Snapshots saved"
msgstr "Снимков сохранено"

msgctxt "ui"
msgid "Status"
msgstr "Статус"

msgctxt "ui"
msgid "TTL must be positive or left empty (unlimited)."
msgstr "TTL должен быть положительным или не указан (бесконечно)."

#, python-brace-format
msgctxt "ttl"
msgid "TTL: {days:d} day"
msgid_plural "TTL: {days:d} days"
msgstr[0] "TTL: {days:d} день"
msgstr[1] "TTL: {days:d} дня"
msgstr[2] "TTL: {days:d} дней"

msgctxt "ui"
msgid "The bot needs the Manage Roles permission."
msgstr "Боту нужно право «Управлять ролями»."

#, python-brace-format
msgctxt "enabled"
msgid "The bot will restore members' roles when they rejoin ({retention})."
msgstr "Бот будет восстанавливать роли участникам при повторном входе ({retention})."

msgctxt "ui"
msgid "unlimited"
msgstr "бесконечно"

msgctxt "ui"
msgid "unlimited retention"
msgstr "бесконечное хранение"

#, python-brace-format
msgctxt "days"
msgid "{days:d} day"
msgid_plural "{days:d} days"
msgstr[0] "{days:d} день"
msgstr[1] "{days:d} дня"
msgstr[2] "{days:d} дней"
