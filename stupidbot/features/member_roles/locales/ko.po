msgstr ""
"Project-Id-Version: StupidBot\n"
"Report-Msgid-Bugs-To: https://github.com/ArtiArtem8/stupid-bot-discord/issues\n"
"POT-Creation-Date: 2026-10-13 00:00+0000\n"
"PO-Revision-Date: 2026-10-13 00:00+0000\n"
"Last-Translator: ArtiArtem8\n"
"Language: ko\n"
"Language-Team: ArtiArtem8\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgctxt "skipped"
msgid "\n\nSkipped {count:d} roles (deleted, inaccessible or the request failed). Existing roles not yet granted have been kept for another attempt."
msgstr "\n\n역할 {count:d}개를 건너뛰었습니다 (삭제됨, 접근 불가 또는 요청 실패). 아직 부여하지 못한 기존 역할은 다시 시도할 수 있도록 보관했습니다."

msgctxt "snapshot"
msgid "- **{name}** — {count:d} roles, left {timestamp}"
msgstr "- **{name}**: 역할 {count:d}개, {timestamp} 서버 나감"

msgctxt "command"
msgid "Days to retain snapshots. Leave empty for unlimited retention"
msgstr "역할 기록 보관 일수. 비워 두면 무기한 보관"

msgctxt "command"
msgid "Delete a member's saved role snapshot"
msgstr "멤버의 저장된 역할 기록 삭제"

msgctxt "command"
msgid "Disable server monitoring"
msgstr "서버 모니터링 끄기"

msgctxt "ui"
msgid "Disabled"
msgstr "꺼짐"

msgctxt "command"
msgid "Enable server monitoring and automatic role restoration"
msgstr "서버 모니터링 및 자동 역할 복원 켜기"

msgctxt "ui"
msgid "Enabled"
msgstr "켜짐"

msgctxt "ui"
msgid "Insufficient permissions"
msgstr "권한 부족"

msgctxt "command"
msgid "Manage server monitoring and role restoration"
msgstr "서버 모니터링 및 역할 복원 관리"

msgctxt "command"
msgid "Manually restore a member's roles"
msgstr "멤버의 역할 수동 복원"

msgctxt "command"
msgid "Member whose roles should be restored"
msgstr "역할을 복원할 멤버"

msgctxt "command"
msgid "Member whose snapshot should be deleted"
msgstr "역할 기록을 삭제할 멤버"

msgctxt "ui"
msgid "Monitoring disabled"
msgstr "모니터링을 껐습니다"

msgctxt "ui"
msgid "Monitoring enabled"
msgstr "모니터링을 켰습니다"

msgctxt "ui"
msgid "Monitoring is already disabled on this server."
msgstr "이 서버에서는 이미 모니터링이 꺼져 있습니다."

msgctxt "status"
msgid "Monitoring status: {guild}"
msgstr "모니터링 상태: {guild}"

msgctxt "ui"
msgid "No roles to restore: the snapshot is missing or expired, or the roles have already been granted."
msgstr "복원할 역할이 없습니다. 저장된 기록이 없거나 만료되었거나, 이미 모든 역할이 부여되었습니다."

msgctxt "missing"
msgid "No saved roles found for {mention}."
msgstr "{mention} 님의 저장된 역할 기록이 없습니다."

msgctxt "recent"
msgid "Recent members ({shown:d} of {total:d})"
msgstr "최근 멤버 (총 {total:d}명 중 {shown:d}명)"

msgctxt "restoration"
msgid "Role restoration: {name}"
msgstr "역할 복원: {name}"

msgctxt "deleted"
msgid "Role snapshot for {mention} deleted."
msgstr "{mention} 님의 역할 기록을 삭제했습니다."

msgctxt "restored"
msgid "Roles restored: {count:d}"
msgstr "복원한 역할: {count:d}개"

msgctxt "ui"
msgid "Saved role snapshots have been kept. Use `/monitor forget` to delete them."
msgstr "저장된 역할 기록은 유지됩니다. 삭제하려면 `/monitor forget`을 사용해 주세요."

msgctxt "command"
msgid "Show monitoring status and saved members"
msgstr "모니터링 상태와 역할 기록이 있는 멤버 표시"

msgctxt "footer"
msgid "Showing the first 10 of {total:d} snapshots"
msgstr "총 {total:d}개 기록 중 처음 10개 표시"

msgctxt "ui"
msgid "Snapshots saved"
msgstr "저장된 역할 기록"

msgctxt "ui"
msgid "Status"
msgstr "상태"

msgctxt "ui"
msgid "TTL must be positive or left empty (unlimited)."
msgstr "보관 기간은 양수여야 합니다. 비워 두면 무기한 보관합니다."

msgctxt "ttl"
msgid "TTL: {days:d} days"
msgstr "보관 기간: {days:d}일"

msgctxt "ui"
msgid "The bot needs the Manage Roles permission."
msgstr "봇에 역할 관리 권한이 필요합니다."

msgctxt "enabled"
msgid "The bot will restore members' roles when they rejoin ({retention})."
msgstr "멤버가 다시 들어오면 봇이 역할을 복원합니다 (보관 기간: {retention})."

msgctxt "ui"
msgid "unlimited"
msgstr "무제한"

msgctxt "ui"
msgid "unlimited retention"
msgstr "무기한"

msgctxt "days"
msgid "{days:d} days"
msgstr "{days:d}일"
