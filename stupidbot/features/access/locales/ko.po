msgctxt "ui"
msgid " • Detailed block information"
msgstr " • 상세 차단 정보"

msgctxt "blocked_status"
msgid "**Blocked**\n• Administrator: <@{admin_id:d}>\n• Date: {timestamp}\n• Reason: {reason}\n"
msgstr "**차단됨**\n• 관리자: <@{admin_id:d}>\n• 일시: {timestamp}\n• 사유: {reason}\n"

msgctxt "user"
msgid "**User:** {identity}"
msgstr "**사용자:** {identity}"

msgctxt "ui"
msgid "Block"
msgstr "차단"

msgctxt "command"
msgid "Block a user from using the bot"
msgstr "사용자의 봇 이용 차단"

msgctxt "list_title"
msgid "Blocked users ({count:d})"
msgstr "차단된 사용자 ({count:d}명)"

msgctxt "ui"
msgid "Current status"
msgstr "현재 상태"

msgctxt "ui"
msgid "Full block history"
msgstr "전체 차단 기록"

msgctxt "ui"
msgid "Name history"
msgstr "이름 변경 기록"

msgctxt "ui"
msgid "Not blocked"
msgstr "차단되지 않음"

msgctxt "ui"
msgid "Not specified"
msgstr "미지정"

msgctxt "ui"
msgid "Only the command author can use these pages."
msgstr "명령어를 실행한 사용자만 페이지를 넘길 수 있습니다."

msgctxt "list_footer"
msgid "Page {page:d}/{pages:d}{detail}"
msgstr "{page:d}/{pages:d}페이지{detail}"

msgctxt "ui"
msgid "Reason"
msgstr "사유"

msgctxt "command"
msgid "Reason for blocking"
msgstr "차단 사유"

msgctxt "command"
msgid "Reason for unblocking"
msgstr "차단 해제 사유"

msgctxt "ui"
msgid "Recent events"
msgstr "최근 기록"

msgctxt "danger"
msgid "Risk level: {level}"
msgstr "위험도: {level}"

msgctxt "command"
msgid "Show additional information"
msgstr "추가 정보 표시"

msgctxt "command"
msgid "Show all blocked users"
msgstr "차단된 사용자 전체 목록"

msgctxt "command"
msgid "Show detailed block information for a user"
msgstr "사용자의 상세 차단 정보 표시"

msgctxt "command"
msgid "Show this message only to you"
msgstr "이 메시지를 나에게만 표시"

msgctxt "ui"
msgid "Statistics"
msgstr "통계"

msgctxt "ui"
msgid "There are no blocked users."
msgstr "차단된 사용자가 없습니다."

msgctxt "ui"
msgid "Unblock"
msgstr "차단 해제"

msgctxt "command"
msgid "Unblock a user from using the bot"
msgstr "사용자의 봇 이용 차단 해제"

msgctxt "departed"
msgid "User has left the server `{user_id:d}`"
msgstr "서버를 떠난 사용자 `{user_id:d}`"

msgctxt "command"
msgid "User to block from this bot"
msgstr "봇 이용을 차단할 사용자"

msgctxt "command"
msgid "User to show information for"
msgstr "정보를 조회할 사용자"

msgctxt "command"
msgid "User to unblock"
msgstr "차단을 해제할 사용자"

msgctxt "event"
msgid "{icon} **{action}** {timestamp}\n• Admin: <@{admin_id:d}>\n• Reason: {reason}"
msgstr "{icon} **{action}** {timestamp}\n• 관리자: <@{admin_id:d}>\n• 사유: {reason}"

msgctxt "blocked"
msgid "{mention} has been blocked"
msgstr "{mention} 님을 차단했습니다"

msgctxt "unblocked"
msgid "{mention} has been unblocked"
msgstr "{mention} 님의 차단을 해제했습니다"

msgctxt "no_history"
msgid "{mention} has no block history."
msgstr "{mention} 님의 차단 기록이 없습니다."

msgctxt "already_blocked"
msgid "{mention} is already blocked."
msgstr "{mention} 님은 이미 차단되어 있습니다."

msgctxt "not_blocked"
msgid "{mention} is not blocked."
msgstr "{mention} 님은 차단되어 있지 않습니다."

msgctxt "name_event"
msgid "{timestamp}:\n• Name: {name}"
msgstr "{timestamp}:\n• 이름: {name}"

msgctxt "admin"
msgid "• Administrator: <@{admin_id:d}>"
msgstr "• 관리자: <@{admin_id:d}>"

msgctxt "current_name"
msgid "• Current name: {name}"
msgstr "• 현재 이름: {name}"

msgctxt "first_block"
msgid "• First block: {timestamp}"
msgstr "• 최초 차단: {timestamp}"

msgctxt "last_block"
msgid "• Last block: {timestamp}"
msgstr "• 최근 차단: {timestamp}"

msgctxt "last_unblock"
msgid "• Last unblock: {timestamp}"
msgstr "• 최근 차단 해제: {timestamp}"

msgctxt "ui"
msgid "• No block history."
msgstr "• 차단 기록이 없습니다."

msgctxt "reason"
msgid "• Reason: {reason}"
msgstr "• 사유: {reason}"

msgctxt "blocks"
msgid "• Total blocks: {count:d}"
msgstr "• 총 차단 횟수: {count:d}"

msgctxt "unblocks"
msgid "• Total unblocks: {count:d}"
msgstr "• 총 차단 해제 횟수: {count:d}"

msgctxt "ui"
msgid "🔴 High"
msgstr "🔴 높음"

msgctxt "ui"
msgid "🟠 Medium"
msgstr "🟠 보통"

msgctxt "ui"
msgid "🟢 Low"
msgstr "🟢 낮음"
