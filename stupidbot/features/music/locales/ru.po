msgctxt "ui"
msgid "Repeat is **off**"
msgstr "Повтор **отключён**"

msgctxt "ui"
msgid "Repeat mode"
msgstr "Залупливание"

msgctxt "ui"
msgid "Repeat mode is **unknown**"
msgstr "Режим повтора **неизвестен**"

#, python-brace-format
msgctxt "requester"
msgid "Requested by: {name}"
msgstr "Запросил: {name}"

msgctxt "ui"
msgid "Restored"
msgstr "Восстановлен"

