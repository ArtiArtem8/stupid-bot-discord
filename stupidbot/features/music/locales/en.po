#, python-brace-format
msgctxt "session_requester"
msgid ""
"\n"
"**Заказчик:** <@{user_id:d}>"
msgstr ""
"\n"
"**Requester:** <@{user_id:d}>"

#, python-brace-format
msgctxt "session_people"
msgid ""
"\n"
"**Заказчиков:** {count:d} чел."
msgstr ""
"\n"
"**Requesters:** {count:d}"

#, python-brace-format
msgctxt "session_skips"
msgid " (скипов: {count:d})"
msgstr " (skipped: {count:d})"

msgctxt "ui"
msgid "*(пусто)*"
msgstr "*(empty)*"

#, python-brace-format
msgctxt "session_tracks"
msgid "**Всего:** {count:d} шт."
msgstr "**Total:** {count:d} tracks"

msgctxt "ui"
msgid "*Тот же самый трек*"
msgstr "*The same track*"

msgctxt "command"
msgid "URL или название"
msgstr "URL or title"

msgctxt "command"
msgid "off — выкл, queue — повтор очереди, track - повтор трека"
msgstr "off — no repeat, queue — repeat queue, track — repeat track"

#, python-brace-format
msgctxt "days"
msgid "{count:d} день"
msgid_plural "{count:d} дня"
msgstr[0] "{count:d} day"
msgstr[1] "{count:d} days"

#, python-brace-format
msgctxt "track_exception"
msgid ""
"{link}\n"
"**Причина:** Источник временно недоступен или не ответил."
msgstr ""
"{link}\n"
"**Reason:** The source is temporarily unavailable or did not respond."

msgctxt "ui"
msgid "В общем:"
msgstr "Summary:"

msgctxt "ui"
msgid "В этой сессии нет треков."
msgstr "There are no tracks in this session."

msgctxt "command"
msgid "Включить/выключить повтор."
msgstr "Enable or disable repeat"

msgctxt "internal_error"
msgid "Внутренняя ошибка музыкального модуля. Детали записаны в лог."
msgstr "An internal music error occurred. Details have been logged."

msgctxt "command"
msgid "Воспроизведение музыки с YT, SoundCloud, Y.Music и VK"
msgstr "Play music from YT, SoundCloud, Y.Music and VK"

msgctxt "ui"
msgid "Воспроизведение остановлено"
msgstr "Playback stopped"

msgctxt "ui"
msgid "Воспроизведение приостановлено"
msgstr "Playback paused"

msgctxt "ui"
msgid "Воспроизведение продолжено"
msgstr "Playback resumed"

msgctxt "recovering"
msgid "Восстанавливаю соединение. Попробуй ещё раз после завершения."
msgstr "Restoring the connection. Try again once recovery finishes."

msgctxt "ui"
msgid "Восстановлен"
msgstr "Restored"

#, python-brace-format
msgctxt "join_timeout"
msgid ""
"Время подключения к {destination} **истекло**\n"
"*Попробуйте сменить регион этого канала!*"
msgstr ""
"Connection to {destination} **timed out**\n"
"*Try changing this channel's region!*"

msgctxt "not_in_voice"
msgid "Вы должны быть в голосовом канале!"
msgstr "You must be in a voice channel!"

msgctxt "ui"
msgid "Вы должны быть в голосовом канале!"
msgstr "You must be in a voice channel!"

msgctxt "command"
msgid "Выйти"
msgstr "Disconnect"

#, python-brace-format
msgctxt "channel_empty"
msgid "Голосовой канал {destination} пуст!"
msgstr "Voice channel {destination} is empty!"

