msgid "Далее"
msgstr "Up next"

msgctxt "ui"
msgid "Длительность"
msgstr "Duration"

msgctxt "ui"
msgid "До свидания ❤️"
msgstr "Goodbye ❤️"

msgctxt "command"
msgid "Добавить трек или плейлист в начало очереди"
msgstr "Add a track or playlist to the front of the queue"

#, python-brace-format
msgctxt "playlist_added"
msgid "Добавлен плейлист **{name}**"
msgstr "Added playlist **{name}**"

msgctxt "ui"
msgid "Добавлено в начало очереди"
msgstr "Added to the front of the queue"

msgctxt "ui"
msgid "Добавлено в очередь"
msgstr "Added to the queue"

msgctxt "ui"
msgid "Залупливание"
msgstr "Repeat mode"

#, python-brace-format
msgctxt "requester"
msgid "Запросил: {name}"
msgstr "Requested by: {name}"

