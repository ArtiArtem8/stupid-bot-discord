msgid ""
"Ничего из этого запроса уже не ожидает в очереди. Возможно, треки уже запустились или"
" очередь была изменена."
msgstr ""
"No tracks from this request are still waiting in the queue. They may have started "
"playing or the queue may have changed."

msgctxt "ui"
msgid "Ничего не играет."
msgstr "Nothing is playing."

msgctxt "nothing_found"
msgid "Ничего не нашлось. Попробуйте ещё раз."
msgstr "Nothing found. Please try again."

msgctxt "ui"
msgid "Ничего не нашлось. Попробуйте ещё раз."
msgstr "Nothing found. Please try again."

msgctxt "command"
msgid "Оставьте пустым, чтобы узнать громкость"
msgstr "Leave empty to check the volume"

msgctxt "command"
msgid "Остановить воспроизведение и очистить очередь"
msgstr "Stop playback and clear the queue"

msgctxt "ui"
msgid "Остановлено"
msgstr "Stopped"

msgctxt "ui"
msgid "Отключился"
msgstr "Disconnected"

msgctxt "command"
msgid "Очередь"
msgstr "Queue"

msgctxt "ui"
msgid "Очередь воспроизведения"
msgstr "Playback queue"

msgctxt "ui"
msgid "Очередь пуста"
msgstr "The queue is empty"

#, python-brace-format
msgctxt "join_failed"
msgid "Ошибка подключения к {destination}"
msgstr "Could not connect to {destination}"

msgctxt "command"
msgid "Пауза"
msgstr "Pause playback"

#, python-brace-format
msgctxt "moved"
msgid "Переместился {origin} -> {destination}"
msgstr "Moved {origin} -> {destination}"

msgctxt "command"
msgid "Переместить тек. трек в конец очереди"
msgstr "Move the current track to the end of the queue"

msgctxt "ui"
msgid "Перемешано"
msgstr "Shuffled"

msgctxt "command"
msgid "Перемешать"
msgstr "Shuffle the queue"

msgctxt "ui"
msgid ""
"Переподключение выполнено, но трек не удалось снова запустить. Скорее всего, источник"
" временно отдал ошибку."
msgstr ""
"Reconnected, but the track could not be restarted. The source most likely returned a "
"temporary error."

msgctxt "command"
msgid "Переподключиться в случае ошибок"
msgstr "Reconnect after an error"

msgctxt "player_changed"
msgid "Плеер изменился во время поиска. Попробуй запустить трек ещё раз."
msgstr "The player changed during the search. Try playing the track again."

msgctxt "player_lost"
msgid "Плеер потерял соединение. Попробуй запустить трек ещё раз."
msgstr "The player lost its connection. Try playing the track again."

msgctxt "player_disconnected"
msgid "Плеер потерял соединение. Попробуйте запустить трек ещё раз."
msgstr "The player lost its connection. Try playing the track again."

msgctxt "ui"
msgid "Плейлист добавлен в начало очереди"
msgstr "Playlist added to the front of the queue"

msgctxt "ui"
msgid "Плейлист запущен"
msgstr "Playlist started"

msgctxt "ui"
msgid "Повтор **отключён**"
msgstr "Repeat is **off**"

msgctxt "ui"
msgid "Повтор очереди **включён**"
msgstr "Queue repeat is **on**"

msgctxt "ui"
msgid "Повтор трека **включён**"
msgstr "Track repeat is **on**"

msgctxt "command"
msgid "Подключиться к голосовому каналу"
msgstr "Connect to a voice channel"

msgctxt "ui"
msgid "Полная история"
msgstr "Full history"

msgctxt "ui"
msgid "Попрошу не трогать, это не ваше сообщение."
msgstr "Please leave this alone; it is not your message."

msgctxt "ui"
msgid "Попытка переподключения сделана"
msgstr "Reconnection attempted"

msgctxt "command"
msgid "Продолжить"
msgstr "Resume playback"

msgctxt "command"
msgid "Пропустить текущий трек"
msgstr "Skip the current track"

msgctxt "ui"
msgid "Пусто"
msgstr "Empty"

msgctxt "ui"
msgid "Режим повтора **неизвестен**"
msgstr "Repeat mode is **unknown**"

msgctxt "ui"
msgid "Сейчас играет"
msgstr "Now playing"

msgctxt "ui"
msgid "Сессия закончена"
msgstr "Session ended"

msgctxt "command"
msgid "Скрыть сообщение"
msgstr "Show this message only to you"

