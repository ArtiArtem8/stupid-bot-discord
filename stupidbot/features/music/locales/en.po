msgid "Недавние треки:"
msgstr "Recent tracks:"

msgctxt "unknown_channel"
msgid "Неизвестный канал"
msgstr "Unknown channel"

msgctxt "not_connected"
msgid "Нет подключения"
msgstr "Not connected"

msgctxt "no_player"
msgid "Нет проигрывателя"
msgstr "No player"

