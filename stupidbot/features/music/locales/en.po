msgid "Как ты этого добился?"
msgstr "How did you manage that?"

msgctxt "unavailable"
msgid "Музыкальный сервис сейчас недоступен. Попробуйте позже."
msgstr "The music service is currently unavailable. Please try again later."

msgctxt "ui"
msgid "Не восстановлено"
msgstr "Not restored"

msgctxt "ui"
msgid "Не удалось воспроизвести трек"
msgstr "Could not play the track"

msgctxt "source_unavailable"
msgid "Не удалось загрузить трек. Источник временно недоступен или не ответил."
msgstr "Could not load the track. The source is temporarily unavailable or did not respond."

msgctxt "ui"
msgid "Не удалось обновить очередь"
msgstr "Could not refresh the queue"

msgctxt "disconnect_failed"
msgid "Не удалось отключиться от голосового канала."
msgstr "Could not disconnect from the voice channel."

msgctxt "connection_failed"
msgid "Не удалось подключиться"
msgstr "Could not connect"

msgctxt "not_member"
msgid "Неверный тип пользователя"
msgstr "Invalid user type"

