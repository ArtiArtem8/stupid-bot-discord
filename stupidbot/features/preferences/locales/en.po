msgctxt "discord"
msgid "As in Discord"
msgstr "As in Discord"

msgctxt "cancel"
msgid "Cancel"
msgstr "Cancel"

msgctxt "cancelled"
msgid "Changes cancelled."
msgstr "Changes cancelled."

msgctxt "reminder"
msgid ""
"Choose a language and timezone for personal replies and your voice profile in "
"/customize-me."
msgstr ""
"Choose a language and timezone for personal replies and your voice profile in "
"/customize-me."

msgctxt "never"
msgid "Do not remind me"
msgstr "Do not remind me"

msgctxt "zone_help"
msgid "For example Europe/Moscow. Leave blank to use the installation default."
msgstr "For example Europe/Moscow. Leave blank to use the installation default."

msgctxt "reminder_disabled"
msgid "I will not remind you again. Settings are available in /customize-me."
msgstr "I will not remind you again. Settings are available in /customize-me."

msgctxt "zone_id"
msgid "IANA timezone"
msgstr "IANA timezone"

msgctxt "command"
msgid "Language and timezone for public server messages"
msgstr "Language and timezone for public server messages"

#, python-brace-format
msgctxt "preview"
msgid ""
"Language: **{language}**\n"
"Timezone: **{timezone}**\n"
"Current time: {local_time}"
msgstr ""
"Language: **{language}**\n"
"Timezone: **{timezone}**\n"
"Current time: {local_time}"

msgctxt "later"
msgid "Later"
msgstr "Later"

msgctxt "reminder_later"
msgid "Okay. Settings are available in /customize-me whenever you need them."
msgstr "Okay. Settings are available in /customize-me whenever you need them."

msgctxt "personal_title"
msgid "Your settings"
msgstr "Your settings"

msgctxt "save"
msgid "Save"
msgstr "Save"

msgctxt "server_title"
msgid "Server settings"
msgstr "Server settings"

msgctxt "open_settings"
msgid "Set up"
msgstr "Set up"

#, python-brace-format
msgctxt "conflict"
msgid "Settings have changed. Current values: {language}, {timezone}. Open the panel again."
msgstr "Settings have changed. Current values: {language}, {timezone}. Open the panel again."

msgctxt "saved"
msgid "Settings saved."
msgstr "Settings saved."

msgctxt "expired"
msgid "This editor has expired. Open settings again."
msgstr "This editor has expired. Open settings again."

msgctxt "owner_only"
msgid "This panel belongs to someone else. Open /customize-me."
msgstr "This panel belongs to someone else. Open /customize-me."

msgctxt "closed"
msgid "This panel is closed or saving. Open settings again."
msgstr "This panel is closed or saving. Open settings again."

msgctxt "reminder_expired"
msgid "This reminder has already been handled."
msgstr "This reminder has already been handled."

msgctxt "timezone"
msgid "Timezone"
msgstr "Timezone"

msgctxt "invalid_zone"
msgid "Unknown IANA timezone. Examples: Europe/Moscow or UTC."
msgstr "Unknown IANA timezone. Examples: Europe/Moscow or UTC."

msgctxt "permission"
msgid "You need Manage Server permission to change server settings."
msgstr "You need Manage Server permission to change server settings."

msgctxt "command"
msgid "Your language and timezone for replies and your profile"
msgstr "Your language and timezone for replies and your profile"

msgctxt "fixed_offset"
msgid "Fixed offset, no daylight saving time"
msgstr "Fixed offset, no daylight saving time"

msgctxt "zone_other"
msgid "Other…"
msgstr "Other…"

msgctxt "reset"
msgid "Reset settings"
msgstr "Reset settings"

msgctxt "personal_scope"
msgid "Across all servers. Server settings stay unchanged."
msgstr "Across all servers. Server settings stay unchanged."

msgctxt "server_scope"
msgid "For shared messages in this server."
msgstr "For shared messages in this server."
