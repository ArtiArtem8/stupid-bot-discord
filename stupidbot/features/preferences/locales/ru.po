msgctxt "zone_id"
msgid "IANA-зона"
msgstr "IANA-зона"

msgctxt "reminder_disabled"
msgid "Больше не буду напоминать. Настройки доступны в /settings."
msgstr "Больше не буду напоминать. Настройки доступны в /settings."

msgctxt "command"
msgid "Ваш язык и часовой пояс"
msgstr "Ваш язык и часовой пояс"

msgctxt "expired"
msgid "Время редактирования истекло. Откройте настройки заново."
msgstr "Время редактирования истекло. Откройте настройки заново."

msgctxt "reminder"
msgid ""
"Выберите язык и часовой пояс для личных ответов и голосового профиля. Это можно "
"сделать в /settings."
msgstr ""
"Выберите язык и часовой пояс для личных ответов и голосового профиля. Это можно "
"сделать в /settings."

msgctxt "permission"
msgid "Для изменения настроек сервера нужно право «Управлять сервером»."
msgstr "Для изменения настроек сервера нужно право «Управлять сервером»."

msgctxt "cancelled"
msgid "Изменения отменены."
msgstr "Изменения отменены."

msgctxt "discord"
msgid "Как в Discord"
msgstr "Как в Discord"

msgctxt "personal_title"
msgid "Личные настройки"
msgstr "Личные настройки"

msgctxt "zone_help"
msgid "Например Europe/Moscow. Пустое поле — настройка установки."
msgstr "Например Europe/Moscow. Пустое поле — настройка установки."

msgctxt "open_settings"
msgid "Настроить"
msgstr "Настроить"

msgctxt "server_title"
msgid "Настройки сервера"
msgstr "Настройки сервера"

msgctxt "saved"
msgid "Настройки сохранены."
msgstr "Настройки сохранены."

#, python-brace-format
msgctxt "conflict"
msgid "Настройки уже изменены. Сейчас: {language}, {timezone}. Откройте панель заново."
msgstr "Настройки уже изменены. Сейчас: {language}, {timezone}. Откройте панель заново."

msgctxt "never"
msgid "Не напоминать"
msgstr "Не напоминать"

msgctxt "invalid_zone"
msgid "Неизвестная IANA-зона. Например: Europe/Moscow или Asia/Krasnoyarsk."
msgstr "Неизвестная IANA-зона. Например: Europe/Moscow или Asia/Krasnoyarsk."

msgctxt "cancel"
msgid "Отмена"
msgstr "Отмена"

msgctxt "closed"
msgid "Панель уже закрыта или сохраняется. Откройте настройки заново."
msgstr "Панель уже закрыта или сохраняется. Откройте настройки заново."

msgctxt "later"
msgid "Позже"
msgstr "Позже"

msgctxt "save"
msgid "Сохранить"
msgstr "Сохранить"

msgctxt "reminder_later"
msgid "Хорошо. Настройки доступны в /settings в любое время."
msgstr "Хорошо. Настройки доступны в /settings в любое время."

msgctxt "timezone"
msgid "Часовой пояс"
msgstr "Часовой пояс"

msgctxt "owner_only"
msgid "Эта панель принадлежит другому пользователю. Откройте /settings."
msgstr "Эта панель принадлежит другому пользователю. Откройте /settings."

msgctxt "reminder_expired"
msgid "Эта подсказка уже обработана."
msgstr "Эта подсказка уже обработана."

msgctxt "command"
msgid "Язык и часовой пояс общих сообщений сервера"
msgstr "Язык и часовой пояс общих сообщений сервера"

#, python-brace-format
msgctxt "preview"
msgid ""
"Язык: **{language}**\n"
"Часовой пояс: **{timezone}**\n"
"Сейчас: {local_time}"
msgstr ""
"Язык: **{language}**\n"
"Часовой пояс: **{timezone}**\n"
"Сейчас: {local_time}"
