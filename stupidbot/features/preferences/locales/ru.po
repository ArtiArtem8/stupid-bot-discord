msgctxt "discord"
msgid "As in Discord"
msgstr "Как в Discord"

msgctxt "cancel"
msgid "Cancel"
msgstr "Отмена"

msgctxt "cancelled"
msgid "Changes cancelled."
msgstr "Изменения отменены."

msgctxt "reminder"
msgid ""
"Choose a language and timezone for personal replies and your voice profile in "
"/settings."
msgstr ""
"Выберите язык и часовой пояс для личных ответов и голосового профиля. Это можно "
"сделать в /settings."

msgctxt "never"
msgid "Do not remind me"
msgstr "Не напоминать"

msgctxt "zone_help"
msgid "For example Europe/Moscow. Leave blank to use the installation default."
msgstr "Например Europe/Moscow. Пустое поле — настройка установки."

msgctxt "reminder_disabled"
msgid "I will not remind you again. Settings are available in /settings."
msgstr "Больше не буду напоминать. Настройки доступны в /settings."

msgctxt "zone_id"
msgid "IANA timezone"
msgstr "IANA-зона"

msgctxt "command"
msgid "Language and timezone for public server messages"
msgstr "Язык и часовой пояс общих сообщений сервера"

#, python-brace-format
msgctxt "preview"
msgid ""
"Language: **{language}**\n"
"Timezone: **{timezone}**\n"
"Current time: {local_time}"
msgstr ""
"Язык: **{language}**\n"
"Часовой пояс: **{timezone}**\n"
"Сейчас: {local_time}"

msgctxt "later"
msgid "Later"
msgstr "Позже"

msgctxt "reminder_later"
msgid "Okay. Settings are available in /settings whenever you need them."
msgstr "Хорошо. Настройки доступны в /settings в любое время."

msgctxt "personal_title"
msgid "Personal settings"
msgstr "Личные настройки"

msgctxt "save"
msgid "Save"
msgstr "Сохранить"

msgctxt "server_title"
msgid "Server settings"
msgstr "Настройки сервера"

msgctxt "open_settings"
msgid "Set up"
msgstr "Настроить"

#, python-brace-format
msgctxt "conflict"
msgid "Settings have changed. Current values: {language}, {timezone}. Open the panel again."
msgstr "Настройки уже изменены. Сейчас: {language}, {timezone}. Откройте панель заново."

msgctxt "saved"
msgid "Settings saved."
msgstr "Настройки сохранены."

msgctxt "expired"
msgid "This editor has expired. Open settings again."
msgstr "Время редактирования истекло. Откройте настройки заново."

msgctxt "owner_only"
msgid "This panel belongs to someone else. Open /settings."
msgstr "Эта панель принадлежит другому пользователю. Откройте /settings."

msgctxt "closed"
msgid "This panel is closed or saving. Open settings again."
msgstr "Панель уже закрыта или сохраняется. Откройте настройки заново."

msgctxt "reminder_expired"
msgid "This reminder has already been handled."
msgstr "Эта подсказка уже обработана."

msgctxt "timezone"
msgid "Timezone"
msgstr "Часовой пояс"

msgctxt "invalid_zone"
msgid "Unknown IANA timezone. Examples: Europe/Moscow or Asia/Krasnoyarsk."
msgstr "Неизвестная IANA-зона. Например: Europe/Moscow или Asia/Krasnoyarsk."

msgctxt "permission"
msgid "You need Manage Server permission to change server settings."
msgstr "Для изменения настроек сервера нужно право «Управлять сервером»."

msgctxt "command"
msgid "Your language and timezone"
msgstr "Ваш язык и часовой пояс"
