msgctxt "answer"
msgid "Доброго утра! Желаю хорошего настроения, бодрости и выполнения всех планов."
msgstr "Доброго утра! Желаю хорошего настроения, бодрости и выполнения всех планов."

msgctxt "answer"
msgid ""
"Желаю доброго, бодрого, позитивного, солнечного, восхитительного, радостного и "
"счастливого утра!"
msgstr ""
"Желаю доброго, бодрого, позитивного, солнечного, восхитительного, радостного и "
"счастливого утра!"

msgctxt "answer"
msgid "Пришло время попрощаться, но только на сегодня"
msgstr "Пришло время попрощаться, но только на сегодня"

msgctxt "answer"
msgid "Пусть ваш ангел-хранитель присмотрит за вами, пока вы спите"
msgstr "Пусть ваш ангел-хранитель присмотрит за вами, пока вы спите"

msgctxt "answer"
msgid ""
"Пусть утро будет добрым, ароматным и бодрящим! А вся неделя легкой, вдохновленной и "
"продуктивной!"
msgstr ""
"Пусть утро будет добрым, ароматным и бодрящим! А вся неделя легкой, вдохновленной и "
"продуктивной!"

msgctxt "answer"
msgid ""
"С добрым утром! Просыпайся, потянись, улыбнись, взбодрись и новый день скорей "
"встречай! Ура!"
msgstr ""
"С добрым утром! Просыпайся, потянись, улыбнись, взбодрись и новый день скорей "
"встречай! Ура!"

msgctxt "answer"
msgid "С добрым утром, с новым днем! Пускай день будет легким, веселым и плодотворным."
msgstr "С добрым утром, с новым днем! Пускай день будет легким, веселым и плодотворным."

msgctxt "answer"
msgid "Сегодня был отличный день, но завтра, как обычно, будет ещё лучше"
msgstr "Сегодня был отличный день, но завтра, как обычно, будет ещё лучше"

msgctxt "answer"
msgid "Сон – это отражение нашего сердца и души"
msgstr "Сон – это отражение нашего сердца и души"

msgctxt "answer"
msgid "Утро доброе, бл*ть!"
msgstr "Утро доброе, бл*ть!"

msgctxt "answer"
msgid "Утром один час лучше, чем два вечером. Таджикская пословица"
msgstr "Утром один час лучше, чем два вечером. Таджикская пословица"

msgctxt "answer"
msgid "Что утром не сделаешь, то вечером не наверстаешь."
msgstr "Что утром не сделаешь, то вечером не наверстаешь."
