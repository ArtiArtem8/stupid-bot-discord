# Required
DISCORD_BOT_TOKEN=

# Optional
DISCORD_BOT_OWNER_ID=
WOLFRAM_APP_ID=
# Opt in only if you need to archive full message content and edits in logs.
MESSAGE_LOG_ENABLED=false

# Voice collector. Existing environment key retained; false disables collection.
VOICE_PROBE_ENABLED=true
# For a new installation, choose the calendar timezone explicitly.
# Europe/Moscow is suggested; keep the existing value when upgrading (unset = UTC).
VOICE_PROFILE_TIMEZONE=Europe/Moscow

# Lavalink. Music commands stay unavailable while the server is unreachable.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NODE_LABEL=MAIN
LAVALINK_CONNECT_RETRY_DELAY=30

# Application emoji IDs after uploading the bundled PNGs in the Developer Portal.
# Empty uses Unicode; an absent key preserves the original deployment ID.
DISCORD_EMOJI_RESTART_ID=
DISCORD_EMOJI_TRASH_ID=
DISCORD_EMOJI_CLOSE_ID=
DISCORD_EMOJI_FIRST_ID=
DISCORD_EMOJI_PREVIOUS_ID=
DISCORD_EMOJI_NEXT_ID=
DISCORD_EMOJI_LAST_ID=
DISCORD_EMOJI_PLAY_ID=
DISCORD_EMOJI_PAUSE_ID=
DISCORD_EMOJI_REPLAY10_ID=
DISCORD_EMOJI_FORWARD10_ID=
DISCORD_EMOJI_SKIP_ID=
DISCORD_EMOJI_MUSICALNOTE_ID=
DISCORD_EMOJI_WHITELINELEFTROUNDED_ID=
DISCORD_EMOJI_WHITELINE_ID=
DISCORD_EMOJI_WHITELINERIGHTROUNDED_ID=
DISCORD_EMOJI_GRAYLINELEFTROUNDED_ID=
DISCORD_EMOJI_GRAYLINE_ID=
DISCORD_EMOJI_GRAYLINERIGHTROUNDED_ID=
DISCORD_EMOJI_STATISTIC_ID=
DISCORD_EMOJI_SOCIAL_ID=
DISCORD_EMOJI_XP_ID=
